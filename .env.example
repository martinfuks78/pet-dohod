# Database Connection
# Vercel Postgres - automaticky nastaveno při deploy na Vercel
POSTGRES_URL="postgres://default:..."
POSTGRES_PRISMA_URL="postgres://default:..."
POSTGRES_URL_NO_SSL="postgres://default:..."
POSTGRES_URL_NON_POOLING="postgres://default:..."
POSTGRES_USER="default"
POSTGRES_HOST="..."
POSTGRES_PASSWORD="..."
POSTGRES_DATABASE="verceldb"

# Email Service (Seznam.cz Email Profi SMTP)
SMTP_USER="web@petdohod.cz"
SMTP_PASSWORD="your-smtp-password"
EMAIL_FROM="web@petdohod.cz"
ADMIN_EMAIL="kouc@martinfuks.cz"

# Admin Authentication
# DŮLEŽITÉ: Použij silné heslo (min 12 znaků, mix velkých, malých, čísel, symbolů)
# Příklad: 'Workshop2026!SecurePass#Admin'
ADMIN_PASSWORD="your-strong-password-here"

# Optional: Node Environment
NODE_ENV="development"

# Sentry Error Tracking (Optional)
# Vytvoř projekt na: https://sentry.io
NEXT_PUBLIC_SENTRY_DSN="https://...@sentry.io/..."
SENTRY_ORG="tvoje-organizace"
SENTRY_PROJECT="pet-dohod"
SENTRY_AUTH_TOKEN="sntrys_..."

# App URL (pro canonical URLs a OG tags)
NEXT_PUBLIC_APP_URL="https://www.petdohod.cz"
